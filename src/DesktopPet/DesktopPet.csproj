<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\pet.ico</ApplicationIcon>
    <AssemblyName>DesktopPet</AssemblyName>
    <RootNamespace>DesktopPet</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\atlas.png" LogicalName="atlas.png" />
    <EmbeddedResource Include="Assets\atlas.json" LogicalName="atlas.json" />
    <EmbeddedResource Include="Assets\pet.ico" LogicalName="pet.ico" />
  </ItemGroup>

</Project>
